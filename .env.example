# ---------------------------------------------------------------------------
# Discord
# ---------------------------------------------------------------------------
# Bot token from https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=
# Application ID (same page, "General Information")
DISCORD_CLIENT_ID=
# Your team's Discord server ID (right-click server -> Copy Server ID)
DISCORD_GUILD_ID=
# Internal channel where drafts land for approval. Clients must NOT be in here.
REVIEW_CHANNEL_ID=
# Optional: Discord role/user IDs allowed to approve and send (comma separated).
# Leave blank to allow anyone who can see the review channel.
APPROVER_IDS=

# ---------------------------------------------------------------------------
# Trello
# ---------------------------------------------------------------------------
# API key: https://trello.com/power-ups/admin -> your Power-Up -> API key
TRELLO_KEY=
# Token: generated from the API key page, needs read access to the board
TRELLO_TOKEN=

# ---------------------------------------------------------------------------
# RingCentral (SMS fallback) - optional, leave blank to disable SMS
# ---------------------------------------------------------------------------
RINGCENTRAL_SERVER_URL=https://platform.ringcentral.com
RINGCENTRAL_CLIENT_ID=
RINGCENTRAL_CLIENT_SECRET=
# JWT credential from the RingCentral app's "Credentials" tab
RINGCENTRAL_JWT=
# The RingCentral number texts are sent from, E.164 e.g. +15551234567
RINGCENTRAL_FROM_NUMBER=

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------
# IANA timezone used to render go-live dates when a card has no Timezone field
DEFAULT_TIMEZONE=America/New_York
# Hours to wait for the agent to reply on Discord before nudging you to text them
FOLLOWUP_HOURS=4
# Set to 1 to log outbound messages instead of actually sending them
DRY_RUN=0

# Name the bot signs client messages with
TEAM_NAME=The Onboarding Team
# Country code assumed for 10-digit phone numbers on Trello cards
DEFAULT_COUNTRY_CODE=+1
